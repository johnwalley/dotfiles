# Stow ignore list (this file REPLACES stow's built-in defaults).
# One Perl regex per line; no-slash patterns match the basename.

# VCS / stow meta
\.git
\.gitignore
\.stow-local-ignore

# Repo docs — not meant for $HOME
README.*
LICENSE.*
COPYING

# Bootstrap script and package list — used from the repo, not linked into $HOME
install\.sh
Brewfile

# Role-specific shell config — sourced from the repo by .zshrc
^/zsh

# Machine-local Claude Code settings — must not be linked into ~/.claude
^/\.claude/settings\.local\.json
