[user]
	name = John Walley
	email = john@walley.org.uk
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBEN5PXNZCrihT1madudlK7EeC8+0922SBPG2NaT6ai9
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[core]
	editor = code --wait
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Work identity for any repo whose remote is in the work GitLab group
[includeIf "hasconfig:remote.*.url:https://gitlab.com/cambridgeintelligence/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@gitlab.com:cambridgeintelligence/**"]
	path = ~/.gitconfig.work
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true

# Untracked machine-local overrides (e.g. commit.gpgsign = false where 1Password is absent).
# Must stay last so it wins. Missing file is ignored.
[include]
	path = ~/.gitconfig.local
